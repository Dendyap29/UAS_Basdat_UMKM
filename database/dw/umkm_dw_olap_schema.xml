<?xml version="1.0" encoding="UTF-8"?>
<!--
  Skema OLAP Mondrian untuk Data Warehouse FORMA (umkm_dw).
  - shared (conformed) dimension: Waktu dan Produk (+ Hari, hierarki pola hari dari dim_waktu)
  - 3 cube, satu per tabel fakta: Penjualan, Pembelian, Pengeluaran
  - 1 virtual cube Keuangan untuk drill-across (agregasi tiap cube dulu, baru disandingkan)
  Diuji dengan database/dw/mondrian/MdxRunner.java dan Schema Workbench.
-->
<Schema name="FORMA_DW">

  <!-- ===================== SHARED DIMENSION ===================== -->

  <Dimension name="Waktu" type="TimeDimension">
    <Hierarchy name="Kalender" hasAll="true" allMemberName="Semua Periode" primaryKey="waktu_key">
      <Table name="dim_waktu"/>
      <Level name="Tahun" column="tahun" type="Numeric" uniqueMembers="true" levelType="TimeYears"/>
      <Level name="Kuartal" column="kuartal" type="Numeric" uniqueMembers="false" levelType="TimeQuarters"/>
      <Level name="Bulan" column="bulan" nameColumn="nama_bulan" ordinalColumn="bulan" type="Numeric" uniqueMembers="false" levelType="TimeMonths"/>
      <Level name="Tanggal" column="tanggal" type="String" uniqueMembers="true" levelType="TimeDays"/>
    </Hierarchy>
  </Dimension>

  <!-- Pola hari memakai tabel dim_waktu yang sama, dipisah dari dimensi Waktu karena
       hierarki waktu Mondrian (TimeDimension) hanya menerima level tahun/kuartal/bulan/minggu/hari. -->
  <Dimension name="Hari">
    <Hierarchy hasAll="true" allMemberName="Semua Hari" primaryKey="waktu_key">
      <Table name="dim_waktu"/>
      <Level name="Jenis Hari" column="jenis_hari" type="String" uniqueMembers="true"/>
      <Level name="Nama Hari" column="hari_dalam_minggu" nameColumn="nama_hari" ordinalColumn="hari_dalam_minggu" type="Numeric" uniqueMembers="true"/>
    </Hierarchy>
  </Dimension>

  <Dimension name="Produk">
    <Hierarchy name="Katalog" hasAll="true" allMemberName="Semua Produk" primaryKey="produk_key">
      <Table name="dim_produk"/>
      <Level name="Kategori" column="nama_kategori" type="String" uniqueMembers="true"/>
      <Level name="Produk" column="id_produk" nameColumn="nama_produk" type="String" uniqueMembers="true"/>
      <Level name="Varian" column="id_varian" type="String" uniqueMembers="true">
        <NameExpression>
          <SQL dialect="mysql">CONCAT(`dim_produk`.`ukuran`, ' / ', `dim_produk`.`warna`)</SQL>
          <SQL dialect="generic">id_varian</SQL>
        </NameExpression>
      </Level>
    </Hierarchy>
    <Hierarchy name="Ukuran" hasAll="true" allMemberName="Semua Ukuran" primaryKey="produk_key">
      <Table name="dim_produk"/>
      <Level name="Ukuran" column="ukuran" type="String" uniqueMembers="true"/>
    </Hierarchy>
    <Hierarchy name="Warna" hasAll="true" allMemberName="Semua Warna" primaryKey="produk_key">
      <Table name="dim_produk"/>
      <Level name="Warna" column="warna" type="String" uniqueMembers="true"/>
    </Hierarchy>
  </Dimension>

  <!-- ===================== CUBE PENJUALAN ===================== -->

  <Cube name="Penjualan" cache="true" enabled="true">
    <Table name="fact_penjualan"/>
    <DimensionUsage name="Waktu" source="Waktu" foreignKey="waktu_key"/>
    <DimensionUsage name="Hari" source="Hari" foreignKey="waktu_key"/>
    <DimensionUsage name="Produk" source="Produk" foreignKey="produk_key"/>

    <Dimension name="Pelanggan" foreignKey="pelanggan_key">
      <Hierarchy hasAll="true" allMemberName="Semua Pelanggan" primaryKey="pelanggan_key">
        <Table name="dim_pelanggan"/>
        <Level name="Tipe" column="tipe_pelanggan" type="String" uniqueMembers="true"/>
        <Level name="Pelanggan" column="id_akun" nameColumn="nama" type="String" uniqueMembers="true"/>
      </Hierarchy>
    </Dimension>

    <Dimension name="Promo" foreignKey="promo_key">
      <Hierarchy hasAll="true" allMemberName="Semua Penjualan" primaryKey="promo_key">
        <Table name="dim_promo"/>
        <Level name="Kelompok Diskon" column="kelompok_diskon" type="String" uniqueMembers="true"/>
        <Level name="Promo" column="id_promo" nameColumn="nama_promo" type="String" uniqueMembers="true"/>
      </Hierarchy>
    </Dimension>

    <Dimension name="Transaksi" foreignKey="transaksi_key">
      <Hierarchy hasAll="true" allMemberName="Semua Kanal" primaryKey="transaksi_key">
        <Table name="dim_transaksi"/>
        <Level name="Kanal" column="kanal_penjualan" type="String" uniqueMembers="true"/>
        <Level name="Metode Bayar" column="metode_pembayaran" type="String" uniqueMembers="false"/>
      </Hierarchy>
    </Dimension>

    <Measure name="Unit Terjual" column="jumlah" aggregator="sum" formatString="#,##0"/>
    <Measure name="Nilai Kotor" column="nilai_kotor" aggregator="sum" formatString="#,##0"/>
    <Measure name="Diskon Promo" column="diskon_promo" aggregator="sum" formatString="#,##0"/>
    <Measure name="Diskon Poin" column="diskon_poin" aggregator="sum" formatString="#,##0"/>
    <Measure name="Omzet" column="pendapatan_bersih" aggregator="sum" formatString="#,##0"/>
    <Measure name="HPP" column="hpp" aggregator="sum" formatString="#,##0"/>
    <Measure name="Laba Kotor" column="laba_kotor" aggregator="sum" formatString="#,##0"/>
    <Measure name="Poin Didapat" column="poin_didapat" aggregator="sum" formatString="#,##0"/>
    <Measure name="Poin Ditukar" column="poin_ditukar" aggregator="sum" formatString="#,##0"/>
    <Measure name="Jumlah Transaksi" column="id_penjualan" aggregator="distinct-count" formatString="#,##0"/>

    <CalculatedMember name="Margin Kotor" dimension="Measures"
        formula="IIf([Measures].[Omzet] = 0, NULL, [Measures].[Laba Kotor] / [Measures].[Omzet])">
      <CalculatedMemberProperty name="FORMAT_STRING" value="0.0%"/>
    </CalculatedMember>
    <CalculatedMember name="Rata-rata Transaksi" dimension="Measures"
        formula="IIf([Measures].[Jumlah Transaksi] = 0, NULL, [Measures].[Omzet] / [Measures].[Jumlah Transaksi])">
      <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0"/>
    </CalculatedMember>
  </Cube>

  <!-- ===================== CUBE PEMBELIAN ===================== -->

  <Cube name="Pembelian" cache="true" enabled="true">
    <Table name="fact_pembelian"/>
    <DimensionUsage name="Waktu" source="Waktu" foreignKey="waktu_key"/>
    <DimensionUsage name="Produk" source="Produk" foreignKey="produk_key"/>

    <Dimension name="Supplier" foreignKey="supplier_key">
      <Hierarchy hasAll="true" allMemberName="Semua Supplier" primaryKey="supplier_key">
        <Table name="dim_supplier"/>
        <Level name="Kota" column="kota" type="String" uniqueMembers="true"/>
        <Level name="Supplier" column="id_supplier" nameColumn="nama_supplier" type="String" uniqueMembers="true"/>
      </Hierarchy>
    </Dimension>

    <Measure name="Unit Dibeli" column="jumlah" aggregator="sum" formatString="#,##0"/>
    <Measure name="Total Pembelian" column="total_biaya" aggregator="sum" formatString="#,##0"/>
    <Measure name="Jumlah Pembelian" column="id_pembelian" aggregator="distinct-count" formatString="#,##0"/>

    <!-- Rata-rata tertimbang jumlah (bukan rata-rata harga per baris) -->
    <CalculatedMember name="Harga Beli Rata-rata" dimension="Measures"
        formula="IIf([Measures].[Unit Dibeli] = 0, NULL, [Measures].[Total Pembelian] / [Measures].[Unit Dibeli])">
      <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0"/>
    </CalculatedMember>
  </Cube>

  <!-- ===================== CUBE PENGELUARAN ===================== -->

  <Cube name="Pengeluaran" cache="true" enabled="true">
    <Table name="fact_pengeluaran"/>
    <DimensionUsage name="Waktu" source="Waktu" foreignKey="waktu_key"/>

    <!-- Degenerate dimension: kolom jenis_pengeluaran langsung dari tabel fakta -->
    <Dimension name="Jenis Pengeluaran">
      <Hierarchy hasAll="true" allMemberName="Semua Jenis">
        <Level name="Jenis" column="jenis_pengeluaran" type="String" uniqueMembers="true"/>
      </Hierarchy>
    </Dimension>

    <Measure name="Biaya Operasional" column="nominal" aggregator="sum" formatString="#,##0"/>
    <Measure name="Jumlah Catatan Biaya" column="id_pengeluaran" aggregator="count" formatString="#,##0"/>
  </Cube>

  <!-- ===================== VIRTUAL CUBE KEUANGAN (drill-across) ===================== -->

  <VirtualCube name="Keuangan" enabled="true">
    <CubeUsages>
      <CubeUsage cubeName="Penjualan" ignoreUnrelatedDimensions="false"/>
      <CubeUsage cubeName="Pembelian" ignoreUnrelatedDimensions="false"/>
      <CubeUsage cubeName="Pengeluaran" ignoreUnrelatedDimensions="true"/>
    </CubeUsages>
    <VirtualCubeDimension name="Waktu"/>
    <VirtualCubeDimension name="Produk"/>

    <VirtualCubeMeasure cubeName="Penjualan" name="[Measures].[Omzet]"/>
    <VirtualCubeMeasure cubeName="Penjualan" name="[Measures].[HPP]"/>
    <VirtualCubeMeasure cubeName="Penjualan" name="[Measures].[Laba Kotor]"/>
    <VirtualCubeMeasure cubeName="Penjualan" name="[Measures].[Unit Terjual]"/>
    <VirtualCubeMeasure cubeName="Pembelian" name="[Measures].[Total Pembelian]"/>
    <VirtualCubeMeasure cubeName="Pembelian" name="[Measures].[Unit Dibeli]"/>
    <VirtualCubeMeasure cubeName="Pengeluaran" name="[Measures].[Biaya Operasional]"/>

    <CalculatedMember name="Laba Operasional" dimension="Measures"
        formula="[Measures].[Laba Kotor] - CoalesceEmpty([Measures].[Biaya Operasional], 0)">
      <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0"/>
    </CalculatedMember>
    <CalculatedMember name="Arus Kas" dimension="Measures"
        formula="CoalesceEmpty([Measures].[Omzet], 0) - CoalesceEmpty([Measures].[Total Pembelian], 0) - CoalesceEmpty([Measures].[Biaya Operasional], 0)">
      <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0"/>
    </CalculatedMember>
    <CalculatedMember name="Selisih Unit Dibeli dan Terjual" dimension="Measures"
        formula="CoalesceEmpty([Measures].[Unit Dibeli], 0) - CoalesceEmpty([Measures].[Unit Terjual], 0)">
      <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0"/>
    </CalculatedMember>
  </VirtualCube>

</Schema>

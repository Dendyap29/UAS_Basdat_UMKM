<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>09_fact_pengeluaran</name>
    <description>ETL Fakta Pengeluaran (Operasional &amp; Pembelian Produk)</description>
    <trans_version>1.0</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
  </info>
  <connection>
    <name>OLTP_UMKM</name>
    <server>127.0.0.1</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>umkm_pakaian</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
  </connection>
  <connection>
    <name>DW_UMKM</name>
    <server>127.0.0.1</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>umkm_dw</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
  </connection>
  <order>
    <hop><from>Extract Pengeluaran (OLTP)</from><to>Lookup dim_jenis_pengeluaran</to><enabled>Y</enabled></hop>
    <hop><from>Lookup dim_jenis_pengeluaran</from><to>Lookup dim_staf</to><enabled>Y</enabled></hop>
    <hop><from>Lookup dim_staf</from><to>Insert / Update fact_pengeluaran</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Extract Pengeluaran (OLTP)</name>
    <type>TableInput</type>
    <description>Extract seluruh catatan pengeluaran dari OLTP</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>OLTP_UMKM</connection>
    <sql>SELECT
  id_pengeluaran,
  CAST(DATE_FORMAT(tanggal_pengeluaran, '%Y%m%d') AS UNSIGNED) AS waktu_key,
  jenis_pengeluaran,
  id_akun AS id_admin,
  ROUND(nominal, 2) AS nominal
FROM pengeluaran
ORDER BY id_pengeluaran</sql>
    <limit>0</limit>
    <GUI><xloc>120</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Lookup dim_jenis_pengeluaran</name>
    <type>DBLookup</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>DW_UMKM</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema/>
      <table>dim_jenis_pengeluaran</table>
      <fail_on_multiple>N</fail_on_multiple>
      <key><name>jenis_pengeluaran</name><field>jenis_pengeluaran</field><condition>=</condition><name2/></key>
      <value><name>jenis_pengeluaran_key</name><rename>jenis_pengeluaran_key</rename><default/><type>Integer</type></value>
    </lookup>
    <GUI><xloc>360</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Lookup dim_staf</name>
    <type>DBLookup</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>DW_UMKM</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema/>
      <table>dim_staf</table>
      <fail_on_multiple>N</fail_on_multiple>
      <key><name>id_admin</name><field>id_akun</field><condition>=</condition><name2/></key>
      <value><name>staf_key</name><rename>staf_key</rename><default>0</default><type>Integer</type></value>
    </lookup>
    <GUI><xloc>580</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Insert / Update fact_pengeluaran</name>
    <type>InsertUpdate</type>
    <description>Muat fakta pengeluaran idempoten berdasarkan id_pengeluaran</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>DW_UMKM</connection>
    <commit>200</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema/>
      <table>fact_pengeluaran</table>
      <key><name>id_pengeluaran</name><field>id_pengeluaran</field><condition>=</condition><name2/></key>
      <value><name>waktu_key</name><rename>waktu_key</rename><update>Y</update></value>
      <value><name>jenis_pengeluaran_key</name><rename>jenis_pengeluaran_key</rename><update>Y</update></value>
      <value><name>staf_key</name><rename>staf_key</rename><update>Y</update></value>
      <value><name>id_pengeluaran</name><rename>id_pengeluaran</rename><update>N</update></value>
      <value><name>nominal</name><rename>nominal</rename><update>Y</update></value>
    </lookup>
    <GUI><xloc>810</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
</transformation>

<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>08_fact_pembelian</name>
    <description>Fakta pembelian stok (DITERIMA)</description>
    <trans_version>2.0</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
  </info>
  <connection>
    <name>OLTP_UMKM</name>
    <server>127.0.0.1</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>umkm_pakaian</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
    <attributes>
      <attribute><code>EXTRA_OPTION_MYSQL.useSSL</code><attribute>false</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.allowPublicKeyRetrieval</code><attribute>true</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.serverTimezone</code><attribute>Asia/Jakarta</attribute></attribute>
    </attributes>
  </connection>
  <connection>
    <name>DW_UMKM</name>
    <server>127.0.0.1</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>umkm_dw</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
    <attributes>
      <attribute><code>EXTRA_OPTION_MYSQL.useSSL</code><attribute>false</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.allowPublicKeyRetrieval</code><attribute>true</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.serverTimezone</code><attribute>Asia/Jakarta</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.rewriteBatchedStatements</code><attribute>true</attribute></attribute>
    </attributes>
  </connection>
  <order>
    <hop><from>Extract pembelian DITERIMA</from><to>Lookup produk_key</to><enabled>Y</enabled></hop>
    <hop><from>Lookup produk_key</from><to>Lookup supplier_key</to><enabled>Y</enabled></hop>
    <hop><from>Lookup supplier_key</from><to>Load fact_pembelian (DW)</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Extract pembelian DITERIMA</name>
    <type>TableInput</type>
    <description></description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>OLTP_UMKM</connection>
    <sql>-- Grain: 1 varian dalam 1 pembelian DITERIMA. Tanggal = tanggal diterima
-- (saat barang masuk stok dan uang keluar). DIPESAN/BATAL tidak dimuat.
SELECT
  dp.id_detail_pembelian,
  dp.id_pembelian,
  CAST(DATE_FORMAT(pb.tanggal_diterima, '%Y%m%d') AS UNSIGNED) AS waktu_key,
  dp.id_varian,
  pb.id_supplier,
  dp.jumlah,
  ROUND(dp.jumlah * dp.harga_satuan, 2) AS total_biaya
FROM detail_pembelian dp
JOIN pembelian_produk pb ON pb.id_pembelian = dp.id_pembelian
WHERE pb.status_pembelian = 'DITERIMA'
ORDER BY dp.id_pembelian, dp.id_detail_pembelian</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <GUI><xloc>100</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Lookup produk_key</name>
    <type>DBLookup</type>
    <description></description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>DW_UMKM</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema/>
      <table>dim_produk</table>
      <orderby/>
      <fail_on_multiple>Y</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>id_varian</name><field>id_varian</field><condition>=</condition><name2/></key>
      <value><name>produk_key</name><rename>produk_key</rename><default/><type>Integer</type></value>
    </lookup>
    <GUI><xloc>320</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Lookup supplier_key</name>
    <type>DBLookup</type>
    <description></description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>DW_UMKM</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema/>
      <table>dim_supplier</table>
      <orderby/>
      <fail_on_multiple>Y</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>id_supplier</name><field>id_supplier</field><condition>=</condition><name2/></key>
      <value><name>supplier_key</name><rename>supplier_key</rename><default/><type>Integer</type></value>
    </lookup>
    <GUI><xloc>540</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Load fact_pembelian (DW)</name>
    <type>TableOutput</type>
    <description></description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>DW_UMKM</connection>
    <schema/>
    <table>fact_pembelian</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>waktu_key</column_name><stream_name>waktu_key</stream_name></field>
      <field><column_name>produk_key</column_name><stream_name>produk_key</stream_name></field>
      <field><column_name>supplier_key</column_name><stream_name>supplier_key</stream_name></field>
      <field><column_name>id_pembelian</column_name><stream_name>id_pembelian</stream_name></field>
      <field><column_name>id_detail_pembelian</column_name><stream_name>id_detail_pembelian</stream_name></field>
      <field><column_name>jumlah</column_name><stream_name>jumlah</stream_name></field>
      <field><column_name>total_biaya</column_name><stream_name>total_biaya</stream_name></field>
    </fields>
    <GUI><xloc>760</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
</transformation>

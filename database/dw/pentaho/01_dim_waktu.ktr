<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>01_dim_waktu</name>
    <description>Dimensi waktu harian (dibangkitkan dari rentang tanggal transaksi OLTP)</description>
    <trans_version>2.0</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
  </info>
  <connection>
    <name>OLTP_UMKM</name>
    <server>127.0.0.1</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>umkm_pakaian</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
    <attributes>
      <attribute><code>EXTRA_OPTION_MYSQL.useSSL</code><attribute>false</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.allowPublicKeyRetrieval</code><attribute>true</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.serverTimezone</code><attribute>Asia/Jakarta</attribute></attribute>
    </attributes>
  </connection>
  <connection>
    <name>DW_UMKM</name>
    <server>127.0.0.1</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>umkm_dw</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
    <attributes>
      <attribute><code>EXTRA_OPTION_MYSQL.useSSL</code><attribute>false</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.allowPublicKeyRetrieval</code><attribute>true</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.serverTimezone</code><attribute>Asia/Jakarta</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.rewriteBatchedStatements</code><attribute>true</attribute></attribute>
    </attributes>
  </connection>
  <order>
    <hop><from>Extract dim_waktu (OLTP)</from><to>Load dim_waktu (DW)</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Extract dim_waktu (OLTP)</name>
    <type>TableInput</type>
    <description></description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>OLTP_UMKM</connection>
    <sql>-- Kalender harian dari awal bulan transaksi pertama s.d. akhir bulan transaksi terakhir
-- (penjualan, pembelian diterima, pengeluaran). Hari tanpa transaksi tetap ada.
WITH RECURSIVE batas AS (
  SELECT DATE_FORMAT(MIN(d), '%Y-%m-01') AS awal, LAST_DAY(MAX(d)) AS akhir
  FROM (
    SELECT DATE(tanggal_penjualan) AS d FROM penjualan
    UNION ALL SELECT DATE(tanggal_diterima) FROM pembelian_produk WHERE status_pembelian = 'DITERIMA'
    UNION ALL SELECT DATE(tanggal_pengeluaran) FROM pengeluaran
  ) x
),
kalender AS (
  SELECT CAST(awal AS DATE) AS tgl, CAST(akhir AS DATE) AS akhir FROM batas
  UNION ALL
  SELECT tgl + INTERVAL 1 DAY, akhir FROM kalender WHERE tgl &lt; akhir
)
SELECT
  CAST(DATE_FORMAT(tgl, '%Y%m%d') AS UNSIGNED) AS waktu_key,
  tgl AS tanggal,
  WEEKDAY(tgl) + 1 AS hari_dalam_minggu,
  ELT(WEEKDAY(tgl) + 1, 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu') AS nama_hari,
  IF(WEEKDAY(tgl) &gt;= 5, 'Akhir pekan', 'Hari kerja') AS jenis_hari,
  MONTH(tgl) AS bulan,
  ELT(MONTH(tgl), 'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli',
      'Agustus', 'September', 'Oktober', 'November', 'Desember') AS nama_bulan,
  QUARTER(tgl) AS kuartal,
  YEAR(tgl) AS tahun
FROM kalender
ORDER BY tgl</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <GUI><xloc>120</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Load dim_waktu (DW)</name>
    <type>TableOutput</type>
    <description></description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>DW_UMKM</connection>
    <schema/>
    <table>dim_waktu</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>waktu_key</column_name><stream_name>waktu_key</stream_name></field>
      <field><column_name>tanggal</column_name><stream_name>tanggal</stream_name></field>
      <field><column_name>hari_dalam_minggu</column_name><stream_name>hari_dalam_minggu</stream_name></field>
      <field><column_name>nama_hari</column_name><stream_name>nama_hari</stream_name></field>
      <field><column_name>jenis_hari</column_name><stream_name>jenis_hari</stream_name></field>
      <field><column_name>bulan</column_name><stream_name>bulan</stream_name></field>
      <field><column_name>nama_bulan</column_name><stream_name>nama_bulan</stream_name></field>
      <field><column_name>kuartal</column_name><stream_name>kuartal</stream_name></field>
      <field><column_name>tahun</column_name><stream_name>tahun</stream_name></field>
    </fields>
    <GUI><xloc>420</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
</transformation>

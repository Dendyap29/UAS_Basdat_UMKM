<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>04_dim_staf</name>
    <description>ETL Dimensi Staf (akun tipe KASIR dan ADMIN)</description>
    <trans_version>1.0</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
  </info>
  <connection>
    <name>OLTP_UMKM</name>
    <server>127.0.0.1</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>umkm_pakaian</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
  </connection>
  <connection>
    <name>DW_UMKM</name>
    <server>127.0.0.1</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>umkm_dw</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
  </connection>
  <order>
    <hop>
      <from>Extract Staf (OLTP)</from>
      <to>Insert / Update dim_staf</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Extract Staf (OLTP)</name>
    <type>TableInput</type>
    <description>Ambil akun KASIR dan ADMIN</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>OLTP_UMKM</connection>
    <sql>SELECT
  id_akun,
  TRIM(nama) AS nama,
  tipe_akun AS peran,
  status_akun
FROM akun
WHERE tipe_akun IN ('KASIR', 'ADMIN')</sql>
    <limit>0</limit>
    <GUI>
      <xloc>160</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Insert / Update dim_staf</name>
    <type>InsertUpdate</type>
    <description>SCD Type 1 ke umkm_dw.dim_staf</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>DW_UMKM</connection>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema/>
      <table>dim_staf</table>
      <key>
        <name>id_akun</name>
        <field>id_akun</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value><name>id_akun</name><rename>id_akun</rename><update>N</update></value>
      <value><name>nama</name><rename>nama</rename><update>Y</update></value>
      <value><name>peran</name><rename>peran</rename><update>Y</update></value>
      <value><name>status_akun</name><rename>status_akun</rename><update>Y</update></value>
    </lookup>
    <GUI>
      <xloc>440</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
</transformation>

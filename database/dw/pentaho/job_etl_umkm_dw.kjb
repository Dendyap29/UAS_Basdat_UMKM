    </entry>
    <entry>
      <name>08_fact_pembelian</name><description/><type>TRANS</type>
      <specification_method>filename</specification_method>
      <trans_object_id/>
      <filename>${Internal.Entry.Current.Directory}/08_fact_pembelian.ktr</filename>
      <transname/>
      <arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
      <set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work>
      <parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>430</xloc><yloc>260</yloc>
    </entry>
    <entry>
      <name>09_fact_pengeluaran</name><description/><type>TRANS</type>
      <specification_method>filename</specification_method>
      <trans_object_id/>
      <filename>${Internal.Entry.Current.Directory}/09_fact_pengeluaran.ktr</filename>
      <transname/>
      <arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
      <set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work>
      <parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>560</xloc><yloc>260</yloc>
    </entry>
    <entry>
      <name>10_validasi_etl</name><description/><type>TRANS</type>
      <specification_method>filename</specification_method>
      <trans_object_id/>
      <filename>${Internal.Entry.Current.Directory}/10_validasi_etl.ktr</filename>
      <transname/>
      <arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
      <set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work>
      <parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>690</xloc><yloc>260</yloc>
    </entry>
    <entry>
      <name>Success</name><description/><type>SUCCESS</type>
      <parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>820</xloc><yloc>260</yloc>
    </entry>
  </entries>
  <hops>
    <hop><from>Start</from><to>00_reset_dw</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>00_reset_dw</from><to>01_dim_waktu</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>01_dim_waktu</from><to>02_dim_produk</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>02_dim_produk</from><to>03_dim_pelanggan</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>03_dim_pelanggan</from><to>04_dim_promo</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>04_dim_promo</from><to>05_dim_transaksi</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>05_dim_transaksi</from><to>06_dim_supplier</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>

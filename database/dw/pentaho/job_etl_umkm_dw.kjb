<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>job_etl_umkm_dw</name>
  <description>ETL penuh OLTP umkm_pakaian ke DW umkm_dw: reset, 6 dimensi, 3 fakta, validasi</description>
  <extended_description/>
  <job_version>2.0</job_version>
  <directory>/</directory>
  <connection>
    <name>OLTP_UMKM</name>
    <server>127.0.0.1</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>umkm_pakaian</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
    <attributes>
      <attribute><code>EXTRA_OPTION_MYSQL.useSSL</code><attribute>false</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.allowPublicKeyRetrieval</code><attribute>true</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.serverTimezone</code><attribute>Asia/Jakarta</attribute></attribute>
    </attributes>
  </connection>
  <connection>
    <name>DW_UMKM</name>
    <server>127.0.0.1</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>umkm_dw</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
    <attributes>
      <attribute><code>EXTRA_OPTION_MYSQL.useSSL</code><attribute>false</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.allowPublicKeyRetrieval</code><attribute>true</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.serverTimezone</code><attribute>Asia/Jakarta</attribute></attribute>
      <attribute><code>EXTRA_OPTION_MYSQL.rewriteBatchedStatements</code><attribute>true</attribute></attribute>
    </attributes>
  </connection>
  <entries>
    <entry>
      <name>Start</name><description/><type>SPECIAL</type><start>Y</start><dummy>N</dummy><repeat>N</repeat>
      <schedulerType>0</schedulerType><intervalSeconds>0</intervalSeconds><intervalMinutes>60</intervalMinutes>
      <hour>12</hour><minutes>0</minutes><weekDay>1</weekDay><DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>60</xloc><yloc>120</yloc>
    </entry>
    <entry>
      <name>00_reset_dw</name>
      <description>Full load: kosongkan fakta dan dimensi, buat baris kunci 0</description>
      <type>SQL</type>
      <sql>SET FOREIGN_KEY_CHECKS = 0;
TRUNCATE TABLE fact_penjualan;
TRUNCATE TABLE fact_pembelian;
TRUNCATE TABLE fact_pengeluaran;
TRUNCATE TABLE dim_waktu;
TRUNCATE TABLE dim_produk;
TRUNCATE TABLE dim_pelanggan;
TRUNCATE TABLE dim_promo;
TRUNCATE TABLE dim_transaksi;
TRUNCATE TABLE dim_supplier;
TRUNCATE TABLE etl_validasi;
SET FOREIGN_KEY_CHECKS = 1;
SET SESSION sql_mode = CONCAT(@@SESSION.sql_mode, ',NO_AUTO_VALUE_ON_ZERO');
INSERT INTO dim_pelanggan (pelanggan_key, id_akun, nama, tipe_pelanggan, tanggal_daftar) VALUES (0, '-', 'Guest (non-member)', 'GUEST', NULL);
INSERT INTO dim_promo (promo_key, id_promo, nama_promo, persen_diskon, kelompok_diskon, tanggal_mulai, tanggal_selesai, durasi_hari) VALUES (0, '-', 'Tanpa promo', 0, 'Tanpa promo', NULL, NULL, 0)</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>DW_UMKM</connection>
      <parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>180</xloc><yloc>120</yloc>
    </entry>
    <entry>
      <name>01_dim_waktu</name><description/><type>TRANS</type>
      <specification_method>filename</specification_method>
      <trans_object_id/>
      <filename>${Internal.Entry.Current.Directory}/01_dim_waktu.ktr</filename>
      <transname/>
      <arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
      <set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work>
      <parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>300</xloc><yloc>120</yloc>
    </entry>
    <entry>
      <name>02_dim_produk</name><description/><type>TRANS</type>
      <specification_method>filename</specification_method>
      <trans_object_id/>
      <filename>${Internal.Entry.Current.Directory}/02_dim_produk.ktr</filename>
      <transname/>
      <arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
      <set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work>
      <parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>430</xloc><yloc>120</yloc>
    </entry>
    <entry>
      <name>03_dim_pelanggan</name><description/><type>TRANS</type>
      <specification_method>filename</specification_method>
      <trans_object_id/>
      <filename>${Internal.Entry.Current.Directory}/03_dim_pelanggan.ktr</filename>
      <transname/>
      <arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
      <set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work>
      <parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>560</xloc><yloc>120</yloc>
    </entry>
    <entry>
      <name>04_dim_promo</name><description/><type>TRANS</type>
      <specification_method>filename</specification_method>
      <trans_object_id/>
      <filename>${Internal.Entry.Current.Directory}/04_dim_promo.ktr</filename>
      <transname/>
      <arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>

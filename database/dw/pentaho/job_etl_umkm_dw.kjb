<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>job_etl_umkm_dw</name>
  <description>Master Job ETL Pentaho Spoon: 6 Transformation Dimensi diikuti 3 Transformation Fakta menuju umkm_dw</description>
  <job_version>1.0</job_version>
  <directory>/</directory>
  <entries>
    <entry>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <start>Y</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>70</xloc>
      <yloc>120</yloc>
    </entry>
    <entry>
      <name>01_dim_waktu</name>
      <type>TRANS</type>
      <specification_method>filename</specification_method>
      <filename>${Internal.Entry.Current.Directory}/01_dim_waktu.ktr</filename>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>200</xloc>
      <yloc>120</yloc>
    </entry>
    <entry>
      <name>02_dim_produk</name>
      <type>TRANS</type>
      <specification_method>filename</specification_method>
      <filename>${Internal.Entry.Current.Directory}/02_dim_produk.ktr</filename>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>340</xloc>
      <yloc>120</yloc>
    </entry>
    <entry>
      <name>03_dim_customer</name>
      <type>TRANS</type>
      <specification_method>filename</specification_method>
      <filename>${Internal.Entry.Current.Directory}/03_dim_customer.ktr</filename>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>490</xloc>
      <yloc>120</yloc>
    </entry>
    <entry>
      <name>04_dim_staf</name>
      <type>TRANS</type>
      <specification_method>filename</specification_method>
      <filename>${Internal.Entry.Current.Directory}/04_dim_staf.ktr</filename>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>640</xloc>
      <yloc>120</yloc>
    </entry>
    <entry>
      <name>05_dim_promo</name>
      <type>TRANS</type>
      <specification_method>filename</specification_method>
      <filename>${Internal.Entry.Current.Directory}/05_dim_promo.ktr</filename>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>780</xloc>
      <yloc>120</yloc>
    </entry>
    <entry>
      <name>06_dim_supplier</name>
      <type>TRANS</type>
      <specification_method>filename</specification_method>
      <filename>${Internal.Entry.Current.Directory}/06_dim_supplier.ktr</filename>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>780</xloc>
      <yloc>260</yloc>
    </entry>
    <entry>
      <name>07_fact_penjualan</name>
      <type>TRANS</type>
      <specification_method>filename</specification_method>
      <filename>${Internal.Entry.Current.Directory}/07_fact_penjualan.ktr</filename>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>600</xloc>
      <yloc>260</yloc>
    </entry>
    <entry>
      <name>08_fact_pembelian</name>
      <type>TRANS</type>
      <specification_method>filename</specification_method>
      <filename>${Internal.Entry.Current.Directory}/08_fact_pembelian.ktr</filename>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>420</xloc>
      <yloc>260</yloc>
    </entry>
    <entry>
      <name>09_fact_pengeluaran</name>
      <type>TRANS</type>
      <specification_method>filename</specification_method>
      <filename>${Internal.Entry.Current.Directory}/09_fact_pengeluaran.ktr</filename>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>240</xloc>
      <yloc>260</yloc>
    </entry>
    <entry>
      <name>Success</name>
      <type>SUCCESS</type>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>80</xloc>
      <yloc>260</yloc>
    </entry>
  </entries>
  <hops>
    <hop><from>Start</from><to>01_dim_waktu</to><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>01_dim_waktu</from><to>02_dim_produk</to><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>02_dim_produk</from><to>03_dim_customer</to><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>03_dim_customer</from><to>04_dim_staf</to><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>04_dim_staf</from><to>05_dim_promo</to><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>05_dim_promo</from><to>06_dim_supplier</to><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>06_dim_supplier</from><to>07_fact_penjualan</to><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>07_fact_penjualan</from><to>08_fact_pembelian</to><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>08_fact_pembelian</from><to>09_fact_pengeluaran</to><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>09_fact_pengeluaran</from><to>Success</to><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
  </hops>
</job>

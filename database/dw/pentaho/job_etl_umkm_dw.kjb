      <exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
      <set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work>
      <parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>820</xloc><yloc>120</yloc>
    </entry>
    <entry>
      <name>06_dim_supplier</name><description/><type>TRANS</type>
      <specification_method>filename</specification_method>
      <trans_object_id/>
      <filename>${Internal.Entry.Current.Directory}/06_dim_supplier.ktr</filename>
      <transname/>
      <arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
      <set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work>
      <parallel>N</parallel><draw>Y</draw><nr>0</nr><xloc>950</xloc><yloc>120</yloc>
    </entry>
    <entry>
      <name>07_fact_penjualan</name><description/><type>TRANS</type>
      <specification_method>filename</specification_method>
      <trans_object_id/>
      <filename>${Internal.Entry.Current.Directory}/07_fact_penjualan.ktr</filename>
      <transname/>
      <arg_from_previous>N</arg_from_previous><params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row><clear_rows>N</clear_rows><clear_files>N</clear_files>
      <set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished><follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder><logging_remote_work>N</logging_remote_work>

<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>05_dim_promo</name>
    <description>ETL Dimensi Promo (durasi_hari &amp; kelompok_diskon)</description>
    <trans_version>1.0</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
  </info>
  <connection>
    <name>OLTP_UMKM</name>
    <server>127.0.0.1</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>umkm_pakaian</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
  </connection>
  <connection>
    <name>DW_UMKM</name>
    <server>127.0.0.1</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>umkm_dw</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted </password>
  </connection>
  <order>
    <hop>
      <from>Extract Promo (OLTP)</from>
      <to>Insert / Update dim_promo</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Extract Promo (OLTP)</name>
    <type>TableInput</type>
    <description>Ambil promo beserta transformasi durasi_hari dan kelompok_diskon</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>OLTP_UMKM</connection>
    <sql>SELECT
  id_promo,
  TRIM(nama_promo) AS nama_promo,
  persen_diskon,
  tanggal_mulai,
  tanggal_selesai,
  DATEDIFF(tanggal_selesai, tanggal_mulai) + 1 AS durasi_hari,
  CASE
    WHEN persen_diskon &lt;= 10 THEN '&lt;=10%'
    WHEN persen_diskon &lt;= 25 THEN '11-25%'
    ELSE '&gt;25%'
  END AS kelompok_diskon
FROM promo</sql>
    <limit>0</limit>
    <GUI>
      <xloc>160</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Insert / Update dim_promo</name>
    <type>InsertUpdate</type>
    <description>SCD Type 1 ke umkm_dw.dim_promo</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>DW_UMKM</connection>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema/>
      <table>dim_promo</table>
      <key>
        <name>id_promo</name>
        <field>id_promo</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value><name>id_promo</name><rename>id_promo</rename><update>N</update></value>
      <value><name>nama_promo</name><rename>nama_promo</rename><update>Y</update></value>
      <value><name>persen_diskon</name><rename>persen_diskon</rename><update>Y</update></value>
      <value><name>tanggal_mulai</name><rename>tanggal_mulai</rename><update>Y</update></value>
      <value><name>tanggal_selesai</name><rename>tanggal_selesai</rename><update>Y</update></value>
      <value><name>durasi_hari</name><rename>durasi_hari</rename><update>Y</update></value>
      <value><name>kelompok_diskon</name><rename>kelompok_diskon</rename><update>Y</update></value>
    </lookup>
    <GUI>
      <xloc>440</xloc>
      <yloc>120</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
</transformation>
